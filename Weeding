<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دعوة زفاف محمد & ريهام</title>
    <!-- خطوط أنيقة تناسب تصميم الدعوة -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Cairo:wght@300;400;600&family=Amiri:ital@0;1&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background-color: #fcf6f5;
            color: #4a3b32;
            font-family: 'Cairo', sans-serif;
            text-align: center;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
        }
        .invitation-card {
            background: #ffffff;
            width: 100%;
            max-width: 480px;
            padding: 40px 25px;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(184, 151, 138, 0.15);
            border: 1px solid #f2e4e1;
            position: relative;
            overflow: hidden;
        }
        .top-title {
            font-family: 'Cinzel', serif;
            letter-spacing: 3px;
            font-size: 1.1rem;
            color: #6c584c;
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        .sub-title {
            font-size: 0.9rem;
            color: #8c7365;
            letter-spacing: 1.5px;
            margin-bottom: 25px;
            text-transform: uppercase;
        }
        .caricature-img {
            width: 100%;
            max-height: 320px;
            object-fit: contain;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .names {
            font-family: 'Amiri', serif;
            font-size: 2.3rem;
            color: #3b2c23;
            font-style: italic;
            margin: 15px 0;
            font-weight: 700;
        }
        .date {
            font-family: 'Cinzel', serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            color: #5c4a40;
            margin: 20px 0;
            font-weight: 600;
        }
        .location {
            font-size: 0.95rem;
            color: #735c50;
            line-height: 1.6;
            background: #faf4f2;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
            border: 1px dashed #e3d0cc;
        }
        .location span {
            display: block;
            font-weight: 600;
            color: #3b2c23;
            margin-top: 5px;
        }
    </style>
</head>
<body>

    <div class="invitation-card">
        <div class="top-title">Join Us</div>
        <div class="sub-title">For The Wedding Of</div>

        <!-- صورة الكاريكاتير الخاصة بكم -->
        <img src="رابط_صورة_الكاريكاتير_هنا" alt="Mohamed & Reham" class="caricature-img">

        <div class="names">Mohamed & Reham</div>

        <div class="date">18 DECEMBER 2026</div>

        <div class="location">
            NOOR WEDDING HALL - ASYUT
            <span>Together Forever</span>
        </div>
    </div>

</body>
</html>
